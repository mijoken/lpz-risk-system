{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mijoken.github.io/lpz-risk-system/schema/public_source_health.schema.json",
  "title": "LPZ Public Source Health",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "generated_at_utc", "overall_status", "sources"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "product": {"const": "LPZ_PUBLIC_SOURCE_HEALTH"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "overall_status": {"type": "string", "enum": ["PASS", "DEGRADED", "FAIL"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "name", "role", "health", "freshness"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["LIVE_MANDATORY", "LIVE_SUPPLEMENTARY", "RESEARCH_ONLY"]},
          "health": {"type": "string", "enum": ["PASS", "STALE", "DEGRADED", "FAIL", "PENDING", "UNKNOWN"]},
          "probe_status": {"type": ["string", "null"]},
          "data_time_utc": {"type": ["string", "null"], "format": "date-time"},
          "age_seconds": {"type": ["integer", "null"], "minimum": 0},
          "freshness_limit_seconds": {"type": ["integer", "null"], "minimum": 0},
          "freshness": {"type": "string", "enum": ["FRESH", "STALE", "MISSING", "NOT_APPLICABLE", "UNKNOWN"]},
          "message": {"type": ["string", "null"]}
        }
      }
    }
  }
}

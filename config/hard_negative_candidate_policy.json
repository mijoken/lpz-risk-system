{
  "schema_version": "0.1.0",
  "phase": "2C-hard-negative-candidate-policy",
  "policy_status": "FROZEN_BEFORE_REAL_HISTORICAL_RAINFALL_PAYLOAD",
  "source_required": "JMA_ANALYZED_RAINFALL_ANNUAL_2017_PLUS",
  "source_geometry_requirement": "OFFICIAL_PRIMARY_SUBDIVISION_POLYGON_OR_AUDITED_EQUIVALENT",
  "candidate_generation": {
    "broad_entry_rule": {
      "operator": "OR",
      "conditions": [
        {"metric": "max_accumulation_mm", "operator": ">=", "value": 80.0},
        {"metric": "area_ge_80mm_km2", "operator": ">=", "value": 500.0}
      ]
    },
    "strength_tags": [
      {"tag": "MAX3H_GE_100", "metric": "max_accumulation_mm", "operator": ">=", "value": 100.0},
      {"tag": "MAX3H_GE_150", "metric": "max_accumulation_mm", "operator": ">=", "value": 150.0},
      {"tag": "AREA80_GE_500", "metric": "area_ge_80mm_km2", "operator": ">=", "value": 500.0},
      {"tag": "AREA100_GE_500", "metric": "area_ge_100mm_km2", "operator": ">=", "value": 500.0},
      {"tag": "RAIN_ONLY_NEAR_OFFICIAL_INTENSITY", "operator": "AND", "conditions": [
        {"metric": "area_ge_100mm_km2", "operator": ">=", "value": 500.0},
        {"metric": "max_accumulation_mm", "operator": ">=", "value": 150.0}
      ]}
    ]
  },
  "positive_exclusion": {
    "same_primary_subdivision": true,
    "minutes_before_anchor": 180,
    "minutes_after_anchor": 180,
    "official_source": "JMA_OFFICIAL_LPZ_CASE_CSV"
  },
  "candidate_status_after_generation": "UNCONFIRMED_HARD_NEGATIVE_CANDIDATE",
  "hard_negative_label_allowed": false,
  "confirmation_requirements": [
    "actual_historical_analyzed_rainfall_payload_audited",
    "candidate_not_inside_positive_exclusion_window",
    "episode_grouping_or_equivalent_duplicate_control_complete",
    "no_outcome_or_model_score_used_to_choose_candidate",
    "candidate_train_validation_holdout_assignment_frozen_before_model_evaluation"
  ],
  "forbidden": [
    "random_sunny_day_negatives_as_primary_control",
    "choose_negatives_after_seeing_model_errors",
    "use_JMA_LPZ_forecast_as_model_feature",
    "use_KIKIKURU_as_model_feature",
    "assign_final_HARD_NEGATIVE_from_rainfall_threshold_alone",
    "treat_1km_analyzed_rainfall_as_250m_instantaneous_radar_morphology"
  ],
  "risk_engine_allowed": false
}
